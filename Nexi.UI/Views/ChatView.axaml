<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Nexi.UI.ViewModels"
             xmlns:models="using:Nexi.UI.Models"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nexi.UI.Views.ChatView"
             x:DataType="vm:ChatViewModel">

  <Grid RowDefinitions="*,Auto,Auto,Auto">
    <!-- Messages Area -->
    <ScrollViewer Grid.Row="0"
                 Name="MessagesScroll"
                 Background="{DynamicResource SystemChromeMediumColor}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Command Instructions Panel -->
        <Border Grid.Row="0"
                Margin="20,20,20,0"
                Padding="16"
                CornerRadius="8"
                Background="#1E1A33"
                BoxShadow="0 2 8 0 #30000000"
                IsVisible="{Binding ShowCommandInstructions}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Command Reference"
                         FontWeight="Bold"
                         FontSize="16"
                         Foreground="#B388FF"
                         Margin="0,0,0,8"/>
              <Button HorizontalAlignment="Right"
                      Background="Transparent"
                      Padding="4"
                      Command="{Binding HideCommandInstructionsCommand}">
                <material:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="#B388FF"/>
              </Button>
            </Grid>

            <TextBlock Text="Ask Nexi in plain language - it turns your request into a desktop action."
                       Foreground="White"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <Expander Header="Desktop Commands"
                      Foreground="#B388FF"
                      IsExpanded="True"
                      Margin="0,4">
              <TextBlock TextWrapping="Wrap" Foreground="White" Margin="8,8,0,0">
                <Run Text="• open [website] - e.g. open github.com (opens in your browser)"/>
                <LineBreak/>
                <Run Text="• open [app] - e.g. open notepad, open chrome"/>
                <LineBreak/>
                <Run Text="• open [folder/file] - e.g. open ~/Documents"/>
                <LineBreak/>
                <Run Text="• search [query] - search the web"/>
              </TextBlock>
            </Expander>

            <Expander Header="System Commands"
                      Foreground="#B388FF"
                      Margin="0,4">
              <TextBlock TextWrapping="Wrap" Foreground="White" Margin="8,8,0,0">
                <Run Text="• system info - show OS, CPU, RAM and uptime"/>
                <LineBreak/>
                <Run Text="• what time is it - show the current time"/>
                <LineBreak/>
                <Run Text="• run [command] - run a shell command (asks for confirmation)"/>
              </TextBlock>
            </Expander>

            <Expander Header="Other"
                      Foreground="#B388FF"
                      Margin="0,4">
              <TextBlock TextWrapping="Wrap" Foreground="White" Margin="8,8,0,0">
                <Run Text="• help - what Nexi can do"/>
                <LineBreak/>
                <Run Text="• Install AI models on the Models page, or just chat - Nexi works offline too"/>
              </TextBlock>
            </Expander>

            <TextBlock Text="Tip: commands that change your system always ask for confirmation first."
                       Foreground="#D8C7FF"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <!-- Messages -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Messages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" Margin="20"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ChatMessage">
              <Border Padding="16"
                      CornerRadius="20,20,20,4"
                      BoxShadow="0 2 8 0 #30000000"
                      Background="{Binding IsUser, Converter={StaticResource BoolToBackgroundConverter}, FallbackValue=#1A1A1A}"
                      Classes.system-message="{Binding IsSystemMessage}"
                      HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                      MaxWidth="600">
                <Border.Styles>
                  <Style Selector="Border.system-message">
                    <Setter Property="Background" Value="#0D1B3E"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="CornerRadius" Value="8"/>
                  </Style>
                </Border.Styles>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Content}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{Binding IsSystemMessage, Converter={StaticResource BoolToSystemMessageForegroundConverter}, FallbackValue=White}"/>
                    <TextBlock Text="{Binding CommandBadge}"
                               IsVisible="{Binding HasCommandBadge}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               Foreground="#D8C7FF"/>
                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:t}}"
                               FontSize="11"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Right"
                               Opacity="0.6"
                               Foreground="White"/>
                  </StackPanel>

                  <!-- Copy Button (only for AI messages) -->
                  <Button Grid.Row="1"
                          Classes="copy-button"
                          HorizontalAlignment="Right"
                          Margin="0,8,0,0"
                          Padding="8,4"
                          Background="#33B388FF"
                          CornerRadius="4"
                          IsVisible="{Binding !IsUser}"
                          Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).CopyToClipboardCommand}"
                          CommandParameter="{Binding Content}"
                          ToolTip.Tip="Copy to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <material:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/>
                      <TextBlock Text="Copy" FontSize="12"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>

    <!-- Confirmation banner for commands that need approval -->
    <Border Grid.Row="1"
            IsVisible="{Binding ShowPendingConfirmation}"
            Margin="20,8,20,0"
            Padding="12,10"
            CornerRadius="8"
            Background="#2A1650"
            BorderBrush="#B388FF"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="White"/>
        <Button Grid.Column="1" Content="Run it" Classes="AccentButton" Margin="12,0,8,0"
                Command="{Binding ConfirmPendingCommand}"/>
        <Button Grid.Column="2" Content="Dismiss" Classes="TransparentButton"
                Command="{Binding DeclinePendingCommand}"/>
      </Grid>
    </Border>

    <!-- Status line -->
    <TextBlock Grid.Row="2"
               Text="{Binding StatusText}"
               FontSize="11"
               Opacity="0.6"
               Margin="24,4,24,0"/>

    <!-- Input Area -->
    <Border Grid.Row="3"
            Background="{DynamicResource SystemChromeMediumLowColor}"
            BorderBrush="{DynamicResource SystemAccentColor}"
            BorderThickness="0,1,0,0"
            BoxShadow="0 -4 8 0 #20000000">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="20,12">
        <!-- Voice Toggle -->
        <ToggleButton Grid.Column="0"
                      Width="40" Height="40"
                      CornerRadius="20"
                      BorderBrush="{DynamicResource SystemAccentColor}"
                      BorderThickness="1.5"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      IsChecked="{Binding IsVoiceModeEnabled}"
                      Command="{Binding ToggleVoiceCommand}"
                      ToolTip.Tip="Toggle voice input">
          <material:MaterialIcon Kind="Microphone" Width="20" Height="20"/>
        </ToggleButton>

        <!-- Help Toggle -->
        <Button Grid.Column="1"
                Width="40" Height="40"
                CornerRadius="20"
                Margin="8,0,0,0"
                BorderBrush="{DynamicResource SystemAccentColor}"
                BorderThickness="1.5"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                Command="{Binding ToggleCommandInstructionsCommand}"
                CommandParameter="{Binding !ShowCommandInstructions}"
                ToolTip.Tip="Show command reference">
          <material:MaterialIcon Kind="HelpCircleOutline" Width="20" Height="20"/>
        </Button>

        <!-- Text Input -->
        <TextBox Grid.Column="2"
                 Name="MessageInput"
                 Text="{Binding CurrentMessage}"
                 PlaceholderText="Type a message..."
                 Height="40"
                 CornerRadius="20"
                 BorderThickness="1.5"
                 BorderBrush="{DynamicResource SystemAccentColor}"
                 VerticalContentAlignment="Center"
                 Margin="16,0"
                 KeyDown="OnInputKeyDown"/>

        <!-- Clear Button -->
        <Button Grid.Column="3"
                Width="40" Height="40"
                CornerRadius="20"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                IsVisible="{Binding HasMessageText}"
                Command="{Binding ClearMessageCommand}"
                ToolTip.Tip="Clear">
          <material:MaterialIcon Kind="Close" Width="20" Height="20"/>
        </Button>

        <!-- Send Button -->
        <Button Grid.Column="4"
                Width="40" Height="40"
                CornerRadius="20"
                Margin="8,0,0,0"
                Classes="send-button"
                Background="{DynamicResource SystemAccentColor}"
                Command="{Binding SendMessageCommand}"
                IsEnabled="{Binding HasMessageText}"
                ToolTip.Tip="Send">
          <material:MaterialIcon Kind="Send" Width="20" Height="20" Foreground="White"/>
        </Button>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.send-button">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Button.send-button:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
    </Style>
    <Style Selector="ToggleButton:checked">
      <Setter Property="Background" Value="#33B388FF"/>
    </Style>
    <Style Selector="ToggleButton:pointerover">
      <Setter Property="Background" Value="#22B388FF"/>
    </Style>
    <Style Selector="Button.copy-button:pointerover">
      <Setter Property="Background" Value="#55B388FF"/>
    </Style>
  </UserControl.Styles>
</UserControl>
