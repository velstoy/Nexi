<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Nexi.UI.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nexi.UI.Views.ChatHistoryView"
             x:DataType="vm:ChatHistoryViewModel">

  <Grid RowDefinitions="Auto,*">
    <!-- Header with Search Bar -->
    <Border Grid.Row="0"
            Background="#1E1A33"
            BoxShadow="0 2 8 0 #30000000"
            Padding="20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock Text="Chat History"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="#B388FF"
                     Margin="0,0,0,8"/>

          <TextBox Text="{Binding SearchQuery}"
                   PlaceholderText="Search conversations..."
                   Height="40"
                   CornerRadius="20"
                   BorderThickness="1.5"
                   BorderBrush="#B388FF"
                   Margin="0,0,10,0">
            <TextBox.InnerLeftContent>
              <material:MaterialIcon Kind="Search"
                                   Width="20" Height="20"
                                   Foreground="#B388FF"
                                   Margin="12,0,0,0"/>
            </TextBox.InnerLeftContent>
            <TextBox.Styles>
              <Style Selector="TextBox:focus">
                <Setter Property="BorderBrush" Value="#D8C7FF"/>
              </Style>
            </TextBox.Styles>
          </TextBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <Button Classes="accent-button"
                  Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding !!SearchQuery}"
                  ToolTip.Tip="Clear search">
            <material:MaterialIcon Kind="Close" Foreground="#B388FF"/>
          </Button>
          <Button Classes="AccentButton"
                  Content="Clear all"
                  Command="{Binding ClearAllCommand}"
                  ToolTip.Tip="Delete all history"/>
          <Button Classes="TransparentButton"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Refresh">
            <material:MaterialIcon Kind="Refresh"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- History Items -->
    <ScrollViewer Grid.Row="1" Background="{DynamicResource SystemChromeMediumColor}">
      <StackPanel Margin="20" Spacing="8">
        <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.6" Margin="0,0,0,8"/>

        <ItemsControl ItemsSource="{Binding FilteredItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatHistoryItemViewModel">
              <Border Background="{DynamicResource SystemChromeMediumLowColor}"
                      CornerRadius="8"
                      Padding="12,10"
                      Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Preview}"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Text="{Binding Timestamp, StringFormat={}{0:g}}"
                                 FontSize="11"
                                 Foreground="#B388FF"
                                 FontWeight="Medium"/>
                      <TextBlock Text="{Binding CommandText}"
                                 FontSize="11"
                                 Opacity="0.6"/>
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="delete-button"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:ChatHistoryViewModel)DataContext).DeleteItemCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Delete entry">
                    <material:MaterialIcon Kind="DeleteOutline" Width="18" Height="18"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.accent-button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.accent-button:pointerover">
      <Setter Property="Background" Value="#33B388FF"/>
    </Style>
    <Style Selector="Button.delete-button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#999999"/>
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="Button.delete-button:pointerover">
      <Setter Property="Background" Value="#33FF5252"/>
      <Setter Property="Foreground" Value="#FF5252"/>
      <Setter Property="Opacity" Value="1.0"/>
    </Style>
  </UserControl.Styles>
</UserControl>
